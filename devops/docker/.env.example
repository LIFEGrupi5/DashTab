# ─────────────────────────────────────────────────────────────────────
# DashTab — Local Development Environment
#
# Copy this file to `.env` in the same directory and adjust as needed:
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real credentials.
# These defaults are intentionally weak — for local dev only.
# Production secrets are managed via Sealed Secrets in k8s overlays.
# ─────────────────────────────────────────────────────────────────────

# ── Postgres ──────────────────────────────────────────────────────────
POSTGRES_USER=dashtab
POSTGRES_PASSWORD=dashtab_dev
POSTGRES_DB=dashtab
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_dev
REDIS_PORT=6379

# ── Keycloak (Identity) ───────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev
KEYCLOAK_PORT=8080

# ── RabbitMQ (Message Broker) ─────────────────────────────────────────
RABBITMQ_USER=dashtab
RABBITMQ_PASSWORD=rabbit_dev
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ── MinIO (S3-compatible object storage) ──────────────────────────────
# MINIO_ROOT_PASSWORD must be at least 8 characters
MINIO_ROOT_USER=dashtab
MINIO_ROOT_PASSWORD=minio_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── MailHog (Dev SMTP catcher) ────────────────────────────────────────
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ── Loki (Log aggregation) ────────────────────────────────────────────
LOKI_PORT=3100

# ── Grafana (Dashboards) ──────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_dev
GRAFANA_PORT=3001

# ── Backend (.NET 10 API) ─────────────────────────────────────────────
BACKEND_PORT=5000

# ── Frontend (Next.js) ────────────────────────────────────────────────
FRONTEND_PORT=3000

# ── Nginx (Reverse Proxy) ─────────────────────────────────────────────
NGINX_PORT=80
