{
  "realm": "dashtab",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "Owner",
        "description": "Full system access"
      },
      {
        "name": "Manager",
        "description": "Manage menu and staff"
      },
      {
        "name": "Waiter",
        "description": "Take and view orders"
      },
      {
        "name": "Kitchen",
        "description": "View and update order status"
      }
    ]
  },
  "clients": [
    {
      "clientId": "dashtab-api",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "dashtab-frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "audience-dashtab-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "dashtab-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "config": {
        "clientId": "GOOGLE_CLIENT_ID_PLACEHOLDER",
        "clientSecret": "GOOGLE_CLIENT_SECRET_PLACEHOLDER",
        "defaultScope": "openid email profile"
      }
    }
  ],
  "users": [
    {
      "username": "owner@dashtab.dev",
      "email": "owner@dashtab.dev",
      "firstName": "Demo",
      "lastName": "Owner",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Owner1!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "Owner"
      ]
    },
    {
      "username": "manager@dashtab.dev",
      "email": "manager@dashtab.dev",
      "firstName": "Demo",
      "lastName": "Manager",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Manager1!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "Manager"
      ]
    },
    {
      "username": "waiter@dashtab.dev",
      "email": "waiter@dashtab.dev",
      "firstName": "Demo",
      "lastName": "Waiter",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Waiter1!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "Waiter"
      ]
    },
    {
      "username": "kitchen@dashtab.dev",
      "email": "kitchen@dashtab.dev",
      "firstName": "Demo",
      "lastName": "Kitchen",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Kitchen1!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "Kitchen"
      ]
    }
  ]
}
